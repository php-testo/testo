{
    "name": "testo/testo",
    "description": "A lightweight PHP testing framework.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "test",
        "tests",
        "testing",
        "dev"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "homepage": "https://php-testo.github.io/",
    "support": {
        "issues": "https://github.com/php-testo/testo/issues",
        "source": "https://github.com/php-testo/testo",
        "docs": "https://php-testo.github.io/"
    },
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-tokenizer": "*",
        "internal/destroy": "^1.0",
        "internal/path": "^1.3",
        "psr/container": "1 - 2",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "symfony/console": "^6.4 || ^7 || ^8.0",
        "symfony/finder": "^6.4 || ^7 || ^8.0",
        "testo/assert": "^0.1.12",
        "testo/fiber": "^0.1.2",
        "testo/bench": "^0.1.8",
        "testo/bridge-symfony-console": "^0.1.9",
        "testo/codecov": "^0.2.0",
        "testo/convention": "^0.1.4",
        "testo/data": "^0.1.8",
        "testo/filter": "^0.1.6",
        "testo/inline": "^0.1.8",
        "testo/lifecycle": "^0.1.5",
        "testo/repeat": "^0.1.9",
        "testo/retry": "^0.1.5",
        "testo/test": "^0.1.6",
        "yiisoft/injector": "^1.2"
    },
    "require-dev": {
        "bamarni/composer-bin-plugin": "^1.8",
        "buggregator/trap": "^1.10",
        "internal/dload": "^1.6",
        "llm/skills": "^1.3",
        "php-vcr/php-vcr": "^1.6",
        "roxblnfk/unpoly": "1.8.2",
        "rector/rector": "^2.5.2",
        "testo/bridge-infection": "^0.1.8",
        "testo/bridge-mockery": "^0.1.2",
        "testo/bridge-rector": "^0.2.3",
        "testo/bridge-revolt": "^0.1.1",
        "testo/bridge-vcr": "^0.1.0",
        "testo/facade": "^0.1.1"
    },
    "suggest": {
        "testo/bridge-infection": "Provides integration with Infection PHP mutation testing framework.",
        "testo/bridge-mockery": "Provides integration with the Mockery mocking framework.",
        "llm/skills": "Ship Testo's bundled AI-agent skills into your project's skills directory automatically."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Testo\\": "core/",
            "Internal\\Container\\": "internal/container/src",
            "Internal\\Fiber\\": "internal/fiber/src"
        }
    },
    "replace": {
        "internal/container": "*",
        "internal/fiber": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Internal\\Container\\Tests\\": "internal/container/tests/",
            "Internal\\Fiber\\Tests\\": "internal/fiber/tests/",
            "Tests\\PhpUnit\\": "tests/PhpUnit/",
            "Tests\\": "tests/",
            "Tests\\Assert\\": "plugin/assert/tests/",
            "Tests\\Fiber\\": "plugin/fiber/tests/",
            "Tests\\Bench\\": "plugin/bench/tests/",
            "Tests\\Bridge\\Mockery\\": "bridge/mockery/tests/",
            "Tests\\Bridge\\Rector\\": "bridge/rector/tests/",
            "Tests\\Bridge\\Revolt\\": "bridge/revolt/tests/",
            "Tests\\Bridge\\SymfonyConsole\\": "bridge/symfony-console/tests/",
            "Tests\\Bridge\\VCR\\": "bridge/vcr/tests/",
            "Tests\\Codecov\\": "plugin/codecov/tests/",
            "Tests\\Convention\\": "plugin/convention/tests/",
            "Tests\\Data\\": "plugin/data/tests/",
            "Tests\\Facade\\": "plugin/facade/tests/",
            "Tests\\Filter\\": "plugin/filter/tests/",
            "Tests\\Lifecycle\\": "plugin/lifecycle/tests/",
            "Tests\\Repeat\\": "plugin/repeat/tests/",
            "Tests\\Retry\\": "plugin/retry/tests/",
            "Tests\\Test\\": "plugin/test/tests/"
        },
        "files": [
            "tests/Fixture/functions.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "plugin/*",
            "options": {
                "symlink": true,
                "versions": {
                    "testo/assert": "0.1.x-dev",
                    "testo/fiber": "0.1.x-dev",
                    "testo/bench": "0.1.x-dev",
                    "testo/codecov": "0.2.x-dev",
                    "testo/convention": "0.1.x-dev",
                    "testo/data": "0.1.x-dev",
                    "testo/facade": "0.1.x-dev",
                    "testo/filter": "0.1.x-dev",
                    "testo/inline": "0.1.x-dev",
                    "testo/lifecycle": "0.1.x-dev",
                    "testo/repeat": "0.1.x-dev",
                    "testo/retry": "0.1.x-dev",
                    "testo/test": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "bridge/*",
            "options": {
                "symlink": true,
                "versions": {
                    "testo/bridge-infection": "0.1.x-dev",
                    "testo/bridge-mockery": "0.1.x-dev",
                    "testo/bridge-rector": "0.2.x-dev",
                    "testo/bridge-revolt": "0.1.x-dev",
                    "testo/bridge-symfony-console": "0.1.x-dev",
                    "testo/bridge-vcr": "0.1.x-dev"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true,
            "llm/skills": true
        },
        "audit": {
            "abandoned": "report"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "skills": {
            "source": "skills"
        },
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": false,
            "target-directory": "tools"
        }
    },
    "scripts": {
        "post-update-cmd": "dload get --no-interaction -v || \"echo can't dload binaries\"",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "rector": "rector",
        "rector:ci": "rector --dry-run --clear-cache --no-progress-bar",
        "infect": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.json --threads=max --min-msi=50"
        ],
        "infect:ci": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --configuration=infection.json --logger-github --threads=max --show-mutations=0 --min-msi=50"
        ],
        "phpunit:build": [
            "@php bin/build-phpunit.php",
            "rector process --config=bin/rector-phpunit-rename.php --no-diffs --no-progress-bar",
            "@composer dump-autoload --quiet",
            "rector process --config=bin/rector-phpunit-build.php --no-diffs --no-progress-bar"
        ],
        "phpunit": "phpunit",
        "infect:phpunit": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.phpunit.json --threads=max --min-msi=0"
        ],
        "infect:phpunit:ci": [
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --configuration=infection.phpunit.json --logger-github --threads=max --show-mutations=0 --min-msi=0"
        ],
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:ci": [
            "@putenv TESTO_CI=1",
            "testo"
        ],
        "test:cc": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "testo --coverage --coverage-clover=runtime/clover.xml"
        ]
    }
}
