{
    "name": "testo/testo",
    "description": "A lightweight PHP testing framework.",
    "license": "BSD-3-Clause",
    "type": "library",
    "keywords": [
        "test",
        "tests",
        "testing",
        "dev"
    ],
    "authors": [
        {
            "name": "Aleksei Gagarin (roxblnfk)",
            "homepage": "https://github.com/roxblnfk"
        }
    ],
    "funding": [
        {
            "type": "boosty",
            "url": "https://boosty.to/roxblnfk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-tokenizer": "*",
        "ext-xmlwriter": "*",
        "internal/destroy": "^1.0",
        "internal/path": "^1.2",
        "psr/container": "1 - 2",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^6.4 || ^7 || ^8.0",
        "symfony/finder": "^6.4 || ^7 || ^8.0",
        "testo/assert": "^1.0@dev",
        "testo/bench": "^1.0@dev",
        "testo/bridge-symfony-console": "^1.0@dev",
        "testo/codecov": "^1.0@dev",
        "testo/convention": "^1.0@dev",
        "testo/data": "^1.0@dev",
        "testo/filter": "^1.0@dev",
        "testo/inline": "^1.0@dev",
        "testo/lifecycle": "^1.0@dev",
        "testo/repeat": "^1.0@dev",
        "testo/retry": "^1.0@dev",
        "testo/test": "^1.0@dev",
        "yiisoft/injector": "^1.2"
    },
    "require-dev": {
        "buggregator/trap": "^1.10",
        "infection/infection": "^0.32.6",
        "internal/dload": "^1.6",
        "roxblnfk/unpoly": "1.8.2",
        "spiral/code-style": "^2.2.2",
        "testo/bridge-infection": "^1.0@dev",
        "vimeo/psalm": "^7.0@dev"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Testo\\": "core/",
            "Internal\\Container\\": "internal/container/src"
        }
    },
    "replace": {
        "internal/container": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Tests\\Assert\\": "plugin/assert/tests/",
            "Tests\\Bench\\": "plugin/bench/tests/",
            "Tests\\Codecov\\": "plugin/codecov/tests/",
            "Tests\\Data\\": "plugin/data/tests/",
            "Tests\\Lifecycle\\": "plugin/lifecycle/tests/",
            "Tests\\Repeat\\": "plugin/repeat/tests/",
            "Tests\\Test\\": "plugin/test/tests/"
        },
        "files": [
            "tests/Fixture/functions.php"
        ]
    },
    "repositories": [
        {
            "type": "path",
            "url": "plugin/*",
            "options": {
                "symlink": true,
                "versions": {
                    "testo/assert": "1.x-dev",
                    "testo/bench": "1.x-dev",
                    "testo/codecov": "1.x-dev",
                    "testo/convention": "1.x-dev",
                    "testo/data": "1.x-dev",
                    "testo/filter": "1.x-dev",
                    "testo/inline": "1.x-dev",
                    "testo/lifecycle": "1.x-dev",
                    "testo/repeat": "1.x-dev",
                    "testo/retry": "1.x-dev",
                    "testo/test": "1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "bridge/*",
            "options": {
                "symlink": true,
                "versions": {
                    "testo/bridge-infection": "1.x-dev",
                    "testo/bridge-symfony-console": "1.x-dev"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "audit": {
            "abandoned": "report"
        },
        "process-timeout": 0,
        "sort-packages": true
    },
    "scripts": {
        "post-update-cmd": "dload get --no-interaction -v || \"echo can't dload binaries\"",
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "infect": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "infection --configuration=infection.json"
        ],
        "infect:ci": [
            "@putenv TESTO_CI=1",
            "@putenv XDEBUG_MODE=coverage",
            "infection --ansi --configuration=infection.json --logger-github --ignore-msi-with-no-mutations --only-covered"
        ],
        "psalm": "psalm",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "psalm:ci": "psalm --output-format=github --shepherd --show-info=false --stats --threads=4",
        "test": "testo",
        "test:ci": [
            "@putenv TESTO_CI=1",
            "testo"
        ]
    }
}
