{
    "require": {
        "infection/infection": "^0.34",
        "testo/bridge-infection": "0.1.x-dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../bridge/*",
            "options": {
                "symlink": true,
                "versions": {
                    "testo/bridge-infection": "0.1.x-dev"
                }
            }
        }
    ],
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
