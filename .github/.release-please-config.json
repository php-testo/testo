{
    "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
    "release-type": "php",
    "separate-pull-requests": true,
    "packages": {
        ".": {
            "package-name": "testo",
            "changelog-path": "/CHANGELOG.md",
            "exclude-paths": ["plugin/**", "bridge/**"]
        },
        "plugin/repeat": {
            "package-name": "testo/repeat",
            "component": "repeat",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/convention": {
            "package-name": "testo/convention",
            "component": "convention",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/lifecycle": {
            "package-name": "testo/lifecycle",
            "component": "lifecycle",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/retry": {
            "package-name": "testo/retry",
            "component": "retry",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/filter": {
            "package-name": "testo/filter",
            "component": "filter",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/test": {
            "package-name": "testo/test",
            "component": "test",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/assert": {
            "package-name": "testo/assert",
            "component": "assert",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/data": {
            "package-name": "testo/data",
            "component": "data",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/inline": {
            "package-name": "testo/inline",
            "component": "inline",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/bench": {
            "package-name": "testo/bench",
            "component": "bench",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/codecov": {
            "package-name": "testo/codecov",
            "component": "codecov",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "plugin/output-teamcity": {
            "package-name": "testo/output-teamcity",
            "component": "output-teamcity",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "bridge/symfony": {
            "package-name": "testo/bridge-symfony",
            "component": "bridge-symfony",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        },
        "bridge/infection": {
            "package-name": "testo/bridge-infection",
            "component": "bridge-infection",
            "include-component-in-tag": true,
            "changelog-path": "CHANGELOG.md"
        }
    },
    "bump-patch-for-minor-pre-major": true,
    "bump-minor-pre-major": true,
    "include-component-in-tag": false,
    "include-v-in-tag": false,
    "changelog-type": "default",
    "changelog-sections": [
        {
            "type": "feat",
            "section": "Features",
            "hidden": false
        },
        {
            "type": "fix",
            "section": "Bug Fixes",
            "hidden": false
        },
        {
            "type": "perf",
            "section": "Performance Improvements",
            "hidden": false
        },
        {
            "type": "docs",
            "section": "Documentation",
            "hidden": false
        },
        {
            "type": "deps",
            "section": "Dependencies",
            "hidden": false
        },
        {
            "type": "refactor",
            "section": "Code Refactoring",
            "hidden": false
        },
        {
            "type": "test",
            "section": "Tests",
            "hidden": true
        },
        {
            "type": "tests",
            "section": "Tests",
            "hidden": true
        },
        {
            "type": "build",
            "section": "Build System",
            "hidden": true
        },
        {
            "type": "ci",
            "section": "Continuous Integration",
            "hidden": true
        },
        {
            "type": "chore",
            "section": "Miscellaneous",
            "hidden": true
        },
        {
            "type": "style",
            "section": "Styles",
            "hidden": true
        },
        {
            "type": "revert",
            "section": "Reverts",
            "hidden": true
        }
    ]
}
